{
  "id": "story_abigail_1",
  "title": "Abigail's Hope",
  "characterId": "abigail",
  "characterName": "Abigail Surya Kencana",
  "scenes": [
    {
      "id": "abigail_001",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Welcome, dear. You look… like someone who's been thinking too much.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_002",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "You could say that. Could you help me make a bouquet, Maria? It's for my mom.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_003",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Of course. A special occasion?",
      "spritePosition": "center"
    },
    {
      "id": "abigail_004",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "Not really. I just… haven't been home much lately. And I heard my father's company will soon start construction around here.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_005",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "I guess I wanted to bring her something before that happens.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_006",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "That's thoughtful of you.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_007",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "Maybe if I bring her flowers, she'll talk to him. She's the only one he really listens to.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_008",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "I don't know if it'll change anything — but it feels wrong not to try.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_009",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "It's never wrong to remind people what beauty looks like. What kind of flowers does she like?",
      "spritePosition": "center"
    },
    {
      "id": "abigail_010",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "She likes… the ones that make the room feel quiet. Not sad quiet — the kind that feels safe.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_011",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Abigail",
      "dialogue": "When I was little, she'd open the window, and the smell would fill the whole house. I remember that most when things get noisy.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Then let's make something that feels like that.",
      "spritePosition": "center"
    }
  ]
}
