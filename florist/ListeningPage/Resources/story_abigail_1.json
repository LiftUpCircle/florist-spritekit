{
  "id": "story_abigail_1",
  "title": "Abigail's Hope",
  "characterId": "abigail",
  "characterName": "Abigail Surya Kencana",
  "scenes": [
    {
      "id": "abigail_001",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Maria",
      "dialogue": "Welcome, dear. You look… like you mind has been walking in circles.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_002",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "Maybe it has.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_003",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "Maria... could you help me make a bouquet?\n It's for my mom.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_004",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Maria",
      "dialogue": "Of couse. Is it her birthday?",
      "spritePosition": "right"
    },
    {
      "id": "abigail_005",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "No...\n Not this time.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_006",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "I haven't been home much lately.\n And I heard the company,\n my father's company will start construction around this area soon",
      "spritePosition": "center"
    },
    {
      "id": "abigail_007",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "They want to clear the old blocks.\n Including this street.\n Including... your shop.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_008",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Maria",
      "dialogue": "Ah.. i see..",
      "spritePosition": "right"
    },
    {
      "id": "abigail_009",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "I tried talking to him, but he won't listen to me.\n Not about this.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_010",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "He only really listens to my mom.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_011",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "So I thought...\n Maybe if i bring her something beautiful, she'll understand how much this place matters,\n how much you matter,\n and how much this shop still holds people together.",
      "spritePosition": "right"
    },
    {
      "id": "abigail_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "I don't know if it will change anything.\n But it feels wrong not to try.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Maria",
      "dialogue": "It's never wrong to follow the tug of your heart.\n What kind of flowers does your mother like?",
      "spritePosition": "center"
    },
    {
      "id": "abigail_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Abigail",
      "dialogue": "She likes the ones that look like they're glowing...\n Simple, but impossible to ignore.\n The kind that makes a room feel warmer.",
      "spritePosition": "center"
    },
    {
      "id": "abigail_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "abigail",
      "characterName": "Maria",
      "dialogue": "Then let's make something that speaks gently, but shines brightly.",
      "spritePosition": "center"
    }
  ]
}
