    },
    {
      "id": "prologue_003",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "Maria",
      "characterName": "Maria",
      "dialogue": "After forty years.\n Forty years of lilies, tulips, celebrations, apologies, and fragile goodbyes.\n Forty years of watching this little street grow… and now watching it be taken away.",
      "spritePosition": "center"
    },
    {
      "id": "prologue_004",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "Maria",
      "characterName": "Maria",
      "dialogue": "Tomorrow they'll take down the sign.\n This place becomes a blueprint.\n A number on someone's development plan.",
      "spritePosition": "center"
    },
    {
      "id": "prologue_005",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "Maria",
      "characterName": "Maria",
      "dialogue": "But today...\n I'll keep the door open.",
      "spritePosition": "center"
    },
    {
      "id": "prologue_006",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "Maria",
      "characterName": "Maria",
      "dialogue": "There's always time for one more story.",
      "spritePosition": "center"
    }
  ]
