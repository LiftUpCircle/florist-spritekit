{
  "id": "story_robert_1",
  "title": "Robert's Bouquet",
  "characterId": "robert",
  "characterName": "Robert Adikusuma",
  "scenes": [
    {
      "id": "robert_001",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "Robert! \nYou're early.",
      "spritePosition": "center"
    },
    {
      "id": "robert_002",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "I figured I'd come before you get busy. \nDidn't want you closing shop without me picking up one last bouquet.",
      "spritePosition": "right"
    },
    {
      "id": "robert_003",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "Still can't live without flowers on your table, huh?",
      "spritePosition": "center"
    },
    {
      "id": "robert_004",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Not really. \nI still put them by the window every week.",
      "spritePosition": "right"
    },
    {
      "id": "robert_005",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "The same kind I used to give my wife.",
      "spritePosition": "right"
    },
    {
      "id": "robert_006",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "She's been gone for a few years now, but… \nI guess old habits never die.",
      "spritePosition": "right"
    },
    {
      "id": "robert_007",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Or maybe I just miss her...",
      "spritePosition": "right"
    },
    {
      "id": "robert_008",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "She wouldn't want you to be sad, Robert.",
      "spritePosition": "center"
    },
    {
      "id": "robert_009",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "She used to light up every time you walked in with flowers.",
      "spritePosition": "center"
    },
    {
      "id": "robert_010",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Yeah… she always said the scent followed me home.",
      "spritePosition": "right"
    },
    {
      "id": "robert_011",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Sometimes, when I pass this street, I swear I still catch it.",
      "spritePosition": "right"
    },
    {
      "id": "robert_012",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "That's because you never stopped bringing her along with you.",
      "spritePosition": "center"
    },
    {
      "id": "robert_013",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Maybe. I just thought… one more bouquet couldn't hurt.",
      "spritePosition": "right"
    },
    {
      "id": "robert_014",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Robert",
      "dialogue": "Something that feels like the way mornings used to.",
      "spritePosition": "right"
    },
    {
      "id": "robert_015",
      "backgroundImage": "BackgroundNew",
      "characterSprite": "robert",
      "characterName": "Maria",
      "dialogue": "Then let's make something that remembers with you.",
      "spritePosition": "center"
    }
  ]
}
