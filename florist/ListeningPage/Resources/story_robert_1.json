{
  "id": "story_robert_1",
  "title": "Robert's Bouquet",
  "characterId": "robert",
  "characterName": "Robert Adikusuma",
  "scenes": [
    {
      "id": "robert_001",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Robert! You're early.",
      "spritePosition": "center"
    },
    {
      "id": "robert_002",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Robert",
      "dialogue": "I figured I'd come before you get busy. Didn't want you closing shop without me picking up one last bouquet.",
      "spritePosition": "right"
    },
    {
      "id": "robert_003",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Still can't live without flowers on your table, huh?",
      "spritePosition": "center"
    },
    {
      "id": "robert_004",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Robert",
      "dialogue": "Not really. I still put them by the window every week. The same kind I used to give my wife.",
      "spritePosition": "right"
    },
    {
      "id": "robert_005",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Robert",
      "dialogue": "She's been gone for a few years now, but… I guess old habits never die. Or maybe I just miss her.",
      "spritePosition": "right"
    },
    {
      "id": "robert_006",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "She wouldn't want you to be sad, Robert. She used to light up every time you walked in with flowers.",
      "spritePosition": "center"
    },
    {
      "id": "robert_007",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Robert",
      "dialogue": "Yeah… she always said the scent followed me home. Sometimes, when I pass this street, I swear I still catch it.",
      "spritePosition": "right"
    },
    {
      "id": "robert_008",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "That's because you never stopped bringing her along with you.",
      "spritePosition": "center"
    },
    {
      "id": "robert_009",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Robert",
      "dialogue": "Maybe. I just thought… one more bouquet couldn't hurt. Something that feels like the way mornings used to.",
      "spritePosition": "right"
    },
    {
      "id": "robert_010",
      "backgroundImage": "background_temp",
      "characterSprite": "character_temp",
      "characterName": "Maria",
      "dialogue": "Then let's make something that remembers with you.",
      "spritePosition": "center"
    }
  ]
}
